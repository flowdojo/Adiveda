{
  "name": "adiveda-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "next:dev": "next dev --turbopack",
    "dev": "npm-run-all --parallel --race next:dev watch-typegen",
    "build": "npm run sanity:typegen && next build",
    "start": "next start",
    "lint": "eslint",
    "sanity:typegen": "mkdir -p ./.sanity && sanity schema extract --path=.sanity/schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "watch-typegen": "tsx watch-typegen.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/icons": "^3.7.4",
    "@sanity/presentation": "^2.0.0",
    "@sanity/react-loader": "^2.0.13",
    "@sanity/vision": "^5.27.0",
    "@sanity/visual-editing": "^5.4.3",
    "class-variance-authority": "^0.7.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide": "^1.3.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-sanity": "^13.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "sanity": "^5.26.0",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
